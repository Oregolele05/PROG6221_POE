<Window x:Class="CyberGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberGuard - Cyber Awareness Bot"
        Height="520" Width="1200"
        MinHeight="450" MinWidth="900"
        Background="#121212"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

	<Window.Resources>

		<!-- ── Rounded Button Base Style ──────────────────────────────── -->
		<Style x:Key="RoundBtn" TargetType="Button">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontFamily" Value="Segoe UI"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="8,6">
							<ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="Opacity" Value="0.85"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="border" Property="Opacity" Value="0.7"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="border" Property="Opacity" Value="0.4"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- ── Send Button Style ──────────────────────────────────────── -->
		<Style x:Key="SendBtn" TargetType="Button" BasedOn="{StaticResource RoundBtn}">
			<Setter Property="Background" Value="#E63946"/>
			<Setter Property="FontSize" Value="12"/>
		</Style>

		<!-- ── TextBox Style ──────────────────────────────────────────── -->
		<Style x:Key="InputBox" TargetType="TextBox">
			<Setter Property="Background" Value="#1E1E1E"/>
			<Setter Property="Foreground" Value="#EDEDED"/>
			<Setter Property="CaretBrush" Value="#FF8C42"/>
			<Setter Property="FontFamily" Value="Segoe UI"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="BorderBrush" Value="#E63946"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Padding" Value="8,0"/>
		</Style>

	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<!-- Title bar -->
			<RowDefinition Height="42"/>
			<!-- Chat area -->
			<RowDefinition Height="*"/>
			<!-- Input bar -->
			<RowDefinition Height="52"/>
		</Grid.RowDefinitions>

		<!-- ══ TITLE BAR ══════════════════════════════════════════════════ -->
		<Border Grid.Row="0" Background="#E63946">
			<Label Content="CYBERGUARD — Cyber Awareness Bot"
                   HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Center"
                   Foreground="White"
                   FontSize="14"
                   FontWeight="Bold"
                   FontFamily="Segoe UI"/>
		</Border>

		<!-- ══ CHAT AREA ══════════════════════════════════════════════════ -->
		<RichTextBox x:Name="chatBox"
                     Grid.Row="1"
                     Margin="12,8,12,4"
                     Background="#1E1E1E"
                     Foreground="#EDEDED"
                     FontFamily="Courier New"
                     FontSize="12"
                     FontWeight="Bold"
                     IsReadOnly="True"
                     BorderThickness="0"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     AcceptsReturn="False">
			<RichTextBox.Resources>
				<!-- Remove default margin on paragraphs -->
				<Style TargetType="Paragraph">
					<Setter Property="Margin" Value="0"/>
				</Style>
			</RichTextBox.Resources>
		</RichTextBox>

		<!-- ══ INPUT BAR ══════════════════════════════════════════════════ -->
		<Grid Grid.Row="2"
              Background="#121212"
              Margin="12,0,12,8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="110"/>
			</Grid.ColumnDefinitions>

			<!-- You: label -->
			<Label Grid.Column="0"
                   Content="You:"
                   VerticalContentAlignment="Center"
                   Foreground="#FF8C42"
                   FontWeight="Bold"
                   FontSize="12"
                   Padding="0,0,6,0"/>

			<!-- Input TextBox -->
			<TextBox x:Name="txtInput"
                     Grid.Column="1"
                     Height="36"
                     Style="{StaticResource InputBox}"
                     KeyDown="txtInput_KeyDown"/>

			<!-- Send Button -->
			<Button x:Name="btnSend"
                    Grid.Column="2"
                    Content="SEND"
                    Height="36"
                    Margin="8,0,0,0"
                    Style="{StaticResource SendBtn}"
                    Click="btnSend_Click"/>
		</Grid>
	</Grid>
</Window>
