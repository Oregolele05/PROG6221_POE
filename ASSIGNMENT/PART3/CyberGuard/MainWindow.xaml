<Window x:Class="CyberGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberGuard - Cyber Awareness Bot"
        Height="550" Width="1200" MinHeight="450" MinWidth="900"
        Background="#121212" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
	<Window.Resources>

		<LinearGradientBrush x:Key="GradientBtn" StartPoint="0,0" EndPoint="1,0">
			<GradientStop Color="#E63946" Offset="0"/>
			<GradientStop Color="#FF8C42" Offset="1"/>
		</LinearGradientBrush>

		<Style x:Key="RoundBtn" TargetType="Button">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontFamily" Value="Segoe UI"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="8,6">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="Opacity" Value="0.85"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="border" Property="Opacity" Value="0.7"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="border" Property="Opacity" Value="0.4"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="SendBtn" TargetType="Button" BasedOn="{StaticResource RoundBtn}">
			<Setter Property="Background" Value="{StaticResource GradientBtn}"/>
			<Setter Property="FontSize" Value="12"/>
		</Style>

		<Style x:Key="SidebarBtn" TargetType="Button" BasedOn="{StaticResource RoundBtn}">
			<Setter Property="Background" Value="{StaticResource GradientBtn}"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="Padding" Value="12,10"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Margin" Value="0,5"/>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Opacity" Value="0.9"/>
				</Trigger>
				<Trigger Property="IsPressed" Value="True">
					<Setter Property="Opacity" Value="0.75"/>
				</Trigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="InputBox" TargetType="TextBox">
			<Setter Property="Background" Value="#1E1E1E"/>
			<Setter Property="Foreground" Value="#EDEDED"/>
			<Setter Property="CaretBrush" Value="#FF8C42"/>
			<Setter Property="FontFamily" Value="Segoe UI"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="BorderBrush" Value="#E63946"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Padding" Value="8,0"/>
		</Style>

	</Window.Resources>

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="130"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- Sidebar -->
		<Border Grid.Column="0" Background="#1E1E1E" BorderBrush="#E63946" BorderThickness="0,0,2,0">
			<StackPanel Margin="10,20">
				<Button Content="💬 Chat"      Style="{StaticResource SidebarBtn}" Click="ChatButton_Click" />
				<Button Content="📋 Tasks"     Style="{StaticResource SidebarBtn}" Click="TasksButton_Click" />
				<Button Content="🎮 Quiz"      Style="{StaticResource SidebarBtn}" Click="QuizButton_Click" />
				<Button Content="🔐 Password"  Style="{StaticResource SidebarBtn}" Click="PasswordCheckerButton_Click" />
				<Button Content="📜 Log"       Style="{StaticResource SidebarBtn}" Click="LogButton_Click" />
			</StackPanel>
		</Border>

		<!-- Main Content -->
		<ContentControl x:Name="MainContent" Grid.Column="1" Margin="0"/>
	</Grid>
</Window>