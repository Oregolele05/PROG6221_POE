<UserControl x:Class="CyberGuard.ChatControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#E63946">
            <Label Content="CYBERGUARD — Chat" HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Center" Foreground="White" FontSize="14" FontWeight="Bold"/>
        </Border>

        <RichTextBox x:Name="chatBox" Grid.Row="1" Margin="12,8,12,4" Background="#1E1E1E"
                     Foreground="#EDEDED" FontFamily="Courier New" FontSize="12" FontWeight="Bold"
                     IsReadOnly="True" BorderThickness="0" VerticalScrollBarVisibility="Auto"/>

        <Grid Grid.Row="2" Background="#121212" Margin="12,0,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="You:" VerticalContentAlignment="Center"
                   Foreground="#FF8C42" FontWeight="Bold" FontSize="12" Padding="0,0,6,0"/>
            <TextBox x:Name="txtInput" Grid.Column="1" Height="36" Style="{StaticResource InputBox}"
                     KeyDown="txtInput_KeyDown"/>
            <Button x:Name="btnSend" Grid.Column="2" Content="SEND" Height="36" Margin="8,0,0,0"
                    Style="{StaticResource SendBtn}" Click="btnSend_Click"/>
        </Grid>
    </Grid>
</UserControl>