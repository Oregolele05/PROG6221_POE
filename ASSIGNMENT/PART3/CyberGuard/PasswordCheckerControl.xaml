<UserControl x:Class="CyberGuard.PasswordCheckerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20" Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E1E1E" Padding="5">
            <Label Content="🔐 PASSWORD STRENGTH CHECKER" Foreground="#FF8C42" FontWeight="Bold" FontSize="14"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,20">
            <Label Content="Enter a password to check its strength:" Foreground="#EDEDED" FontSize="14"/>
            <PasswordBox x:Name="txtPassword" Style="{StaticResource PasswordInputBox}" Height="36" 
                         PasswordChanged="TxtPassword_PasswordChanged" Margin="0,5"/>
            <ProgressBar x:Name="strengthBar" Height="20" Margin="0,10" Minimum="0" Maximum="100" Foreground="#FF8C42"/>
            <TextBlock x:Name="lblStrength" Foreground="#EDEDED" FontSize="14" TextWrapping="Wrap" Text="Strength: (type a password above)"/>
            <TextBlock x:Name="lblFeedback" Foreground="#FF8C42" FontSize="12" TextWrapping="Wrap" Margin="0,10" 
                       Text="Suggestions will appear here as you type."/>
        </StackPanel>

        <Button Grid.Row="2" Content="⬅ Back to Chat" Style="{StaticResource SendBtn}"
                Width="150" HorizontalAlignment="Center" Click="BackToChat_Click" Margin="0,10"/>
    </Grid>
</UserControl>