<UserControl x:Class="CyberGuard.ActivityLogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CyberGuard">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E1E1E" Padding="5">
            <Label Content="📜 ACTIVITY LOG" Foreground="#FF8C42" FontWeight="Bold" FontSize="14"/>
        </Border>

        <ListBox x:Name="lstLog" Grid.Row="1" Margin="0,5" Background="#1E1E1E" Foreground="#EDEDED" 
                 ItemsSource="{Binding Source={x:Static local:CyberLogger.Log}}"/>

        <Button Grid.Row="2" Content="⬅ Back to Chat" Style="{StaticResource SendBtn}"
                Width="150" HorizontalAlignment="Center" Click="BackToChat_Click" Margin="0,10"/>
    </Grid>
</UserControl>