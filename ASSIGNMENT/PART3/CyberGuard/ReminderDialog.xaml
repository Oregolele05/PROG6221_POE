<Window x:Class="CyberGuard.ReminderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set Reminder" Height="150" Width="300" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="10">
        <Label Content="Select reminder date:" Foreground="#EDEDED" FontWeight="Bold"/>
        <DatePicker x:Name="dpReminder" Margin="0,5" Background="#1E1E1E" Foreground="#EDEDED"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <Button Content="OK" Click="Ok_Click" Style="{StaticResource SendBtn}" Width="80" Margin="5"/>
            <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource SendBtn}" Background="#555" Width="80" Margin="5"/>
        </StackPanel>
    </StackPanel>
</Window>